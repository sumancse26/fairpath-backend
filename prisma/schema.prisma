// ================================================================
// Cluster C: Registries, Lookups and Rules
// ================================================================

// ---------- Lookup master / detail ----------
// lookup_mst : one row per lookup group  (e.g. BOOKING_STATUS, PAYMENT_METHOD)
// lookup_dtl : the values of that group  (e.g. CONFIRMED, BKASH)

model LookupMst {
  id          BigInt      @id @default(autoincrement())
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(100)
  description String?     @db.Text
  isSystem    Boolean     @default(false) @map("is_system") // system groups cannot be deleted from UI
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6) @map("updated_at")
  details     LookupDtl[] @relation("fk_lookup_dtl_lookup_mst_id")

  @@map("lookup_mst")
}

model LookupDtl {
  id            BigInt       @id @default(autoincrement())
  lookupMstId   BigInt       @map("lookup_mst_id")
  productTypeId BigInt?      @map("product_type_id") // NULL = global value, set = product-type-specific value
  code          String       @db.VarChar(50)
  label         String       @db.VarChar(100)
  description   String?      @db.Text
  sortOrder     Int          @default(0) @map("sort_order")
  isSystem      Boolean      @default(false) @map("is_system")
  isActive      Boolean      @default(true) @map("is_active")
  metadata      Json?        // optional extras: color, icon, isTerminal, ISO code, etc.
  createdAt     DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6) @map("updated_at")

  lookupMst     LookupMst    @relation("fk_lookup_dtl_lookup_mst_id", fields: [lookupMstId], references: [id])
  productType   ProductType? @relation("fk_35_lookup_value_product_type_id", fields: [productTypeId], references: [id])

  // NOTE: Postgres treats NULLs as distinct, so also add a partial unique index in a SQL migration:
  //   CREATE UNIQUE INDEX uq_lookup_dtl_global ON lookup_dtl (lookup_mst_id, code) WHERE product_type_id IS NULL;
  @@unique([lookupMstId, productTypeId, code])
  @@index([lookupMstId])
  @@index([productTypeId])
  @@map("lookup_dtl")

  // ---------- back-relations (one per business column that points here) ----------
  // Cluster A
  tenantsByStatus                Tenant[]                    @relation("lk_Tenant_status")
  tenantsByPaymentModel          Tenant[]                    @relation("lk_Tenant_paymentModel")
  agentsByStatus                 Agent[]                     @relation("lk_Agent_status")
  tenantSettingsByScopeType      TenantSetting[]             @relation("lk_TenantSetting_scopeType")
  staffUsersByStatus             StaffUser[]                 @relation("lk_StaffUser_status")
  staffFederatedByProvider       StaffFederatedIdentity[]    @relation("lk_StaffFederatedIdentity_provider")
  kycByKycType                   KycSubmission[]             @relation("lk_KycSubmission_kycType")
  kycByIdType                    KycSubmission[]             @relation("lk_KycSubmission_idType")
  kycByStatus                    KycSubmission[]             @relation("lk_KycSubmission_status")
  membershipsByStatus            Membership[]                @relation("lk_Membership_status")
  approvalsByActionType          ApprovalRequest[]           @relation("lk_ApprovalRequest_actionType")
  approvalsByStatus              ApprovalRequest[]           @relation("lk_ApprovalRequest_status")
  auditLogsByActorType           AuditLog[]                  @relation("lk_AuditLog_actorType")
  auditLogsByAction              AuditLog[]                  @relation("lk_AuditLog_action")
  auditLogsByEntityType          AuditLog[]                  @relation("lk_AuditLog_entityType")
  // Cluster B
  customerFederatedByProvider    CustomerFederatedIdentity[] @relation("lk_CustomerFederatedIdentity_provider")
  savedTravelersByGender         SavedTraveler[]             @relation("lk_SavedTraveler_gender")
  savedTravelersByNationality    SavedTraveler[]             @relation("lk_SavedTraveler_nationality")
  savedTravelersByType           SavedTraveler[]             @relation("lk_SavedTraveler_travelerType")
  savedTravelerDocsByDocType     SavedTravelerDocument[]     @relation("lk_SavedTravelerDocument_docType")
  savedTravelerDocsByCountry     SavedTravelerDocument[]     @relation("lk_SavedTravelerDocument_country")
  apiKeysByKeyType               ApiKey[]                    @relation("lk_ApiKey_keyType")
  outboxByTopic                  OutboxEvent[]               @relation("lk_OutboxEvent_topic")
  outboxByEventType              OutboxEvent[]               @relation("lk_OutboxEvent_eventType")
  outboxByStatus                 OutboxEvent[]               @relation("lk_OutboxEvent_status")
  // Cluster C
  productTypesByInventoryModel   ProductType[]               @relation("lk_ProductType_inventoryModel")
  attributeDefsByEntityType      AttributeDefinition[]       @relation("lk_AttributeDefinition_entityType")
  attributeDefsByDataType        AttributeDefinition[]       @relation("lk_AttributeDefinition_dataType")
  attributeDefsByVisibility      AttributeDefinition[]       @relation("lk_AttributeDefinition_visibility")
  policyDefsByValueType          PolicyDefinition[]          @relation("lk_PolicyDefinition_valueType")
  workflowStatusesByStatus       WorkflowStatus[]            @relation("lk_WorkflowStatus_status")
  workflowTransitionsByFrom      WorkflowTransition[]        @relation("lk_WorkflowTransition_fromStatus")
  workflowTransitionsByTo        WorkflowTransition[]        @relation("lk_WorkflowTransition_toStatus")
  rulesByRuleType                Rule[]                      @relation("lk_Rule_ruleType")
  rulesByScopeType               Rule[]                      @relation("lk_Rule_scopeType")
  templatesByTemplateType        Template[]                  @relation("lk_Template_templateType")
  templatesByEventType           Template[]                  @relation("lk_Template_eventType")
  templatesByLocale              Template[]                  @relation("lk_Template_locale")
  // Cluster D
  locationsByLocationType        Location[]                  @relation("lk_Location_locationType")
  locationsByTimezone            Location[]                  @relation("lk_Location_timezone")
  offeringsBySelectionMode       Offering[]                  @relation("lk_Offering_selectionMode")
  layoutTemplatesByStatus        LayoutTemplate[]            @relation("lk_LayoutTemplate_status")
  layoutCellsByCellType          LayoutCell[]                @relation("lk_LayoutCell_cellType")
  layoutCellsByUnitType          LayoutCell[]                @relation("lk_LayoutCell_unitType")
  layoutCellsByPosition          LayoutCell[]                @relation("lk_LayoutCell_position")
  layoutCellsByPriceTier         LayoutCell[]                @relation("lk_LayoutCell_priceTier")
  layoutCellsBySellMode          LayoutCell[]                @relation("lk_LayoutCell_sellMode")
  resourcesByStatus              Resource[]                  @relation("lk_Resource_status")
  resourceDocsByDocType          ResourceDocument[]          @relation("lk_ResourceDocument_docType")
  serviceLinesByStatus           ServiceLine[]               @relation("lk_ServiceLine_status")
  fareRulesByComponentType       FareRule[]                  @relation("lk_FareRule_componentType")
  ancillaryProductsByCategory    AncillaryProduct[]          @relation("lk_AncillaryProduct_category")
  ancillaryOffersByScopeType     AncillaryOffer[]            @relation("lk_AncillaryOffer_scopeType")
  // Cluster E
  tripsByStatus                  Trip[]                      @relation("lk_Trip_status")
