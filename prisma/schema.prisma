  isRequired    Boolean      @map("is_required")
  isSearchable  Boolean      @map("is_searchable")
  isEncrypted   Boolean      @map("is_encrypted")
  visibilityId  BigInt       @map("visibility_id")  // VISIBILITY
  schemaVersion Int          @map("schema_version")
  isActive      Boolean      @map("is_active")
  entityType    LookupDtl    @relation("lk_AttributeDefinition_entityType", fields: [entityTypeId], references: [id])
  dataType      LookupDtl    @relation("lk_AttributeDefinition_dataType", fields: [dataTypeId], references: [id])
  visibility    LookupDtl    @relation("lk_AttributeDefinition_visibility", fields: [visibilityId], references: [id])
  productType   ProductType? @relation("fk_36_attribute_definition_product_type_id", fields: [productTypeId], references: [id])

  @@index([productTypeId])
  @@map("attribute_definition")
}

model PolicyDefinition {
