generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ================================================================
// Cluster A: Tenancy and Access
// ================================================================

model Tenant {
  id                     BigInt                  @id @default(autoincrement())
  planId                 BigInt                  @map("plan_id")
  name                   String                  @db.VarChar(100)
  status                 String                  @db.VarChar(30)
  paymentModel           String                  @db.VarChar(30) @map("payment_model")
  domain                 String?                 @db.VarChar(255)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6) @map("updated_at")
  version                Int                     @default(1)
  plan                   Plan                    @relation("fk_1_tenant_plan_id", fields: [planId], references: [id])
  tenantProductTypes     TenantProductType[]     @relation("fk_2_tenant_product_type_tenant_id")
  branches               Branch[]                @relation("fk_4_branch_tenant_id")
  agents                 Agent[]                 @relation("fk_5_agent_tenant_id")
  tenantSettings         TenantSetting[]         @relation("fk_8_tenant_setting_tenant_id")
  memberships            Membership[]            @relation("fk_10_membership_tenant_id")
  roles                  Role[]                  @relation("fk_13_role_tenant_id")
  approvalRequests       ApprovalRequest[]       @relation("fk_16_approval_request_tenant_id")
  customerProfiles       CustomerProfile[]       @relation("fk_19_customer_profile_tenant_id")
  savedTravelers         SavedTraveler[]         @relation("fk_21_saved_traveler_tenant_id")
  savedTravelerDocuments SavedTravelerDocument[] @relation("fk_23_saved_traveler_document_tenant_id")
  customerSessions       CustomerSession[]       @relation("fk_26_customer_session_tenant_id")
  salesDomains           SalesDomain[]           @relation("fk_27_sales_domain_tenant_id")
  apiKeys                ApiKey[]                @relation("fk_28_api_key_tenant_id")
  webhookEndpoints       WebhookEndpoint[]       @relation("fk_30_webhook_endpoint_tenant_id")
  outboxEvents           OutboxEvent[]           @relation("fk_31_outbox_event_tenant_id")
  idempotencyKeys        IdempotencyKey[]        @relation("fk_32_idempotency_key_tenant_id")
  rules                  Rule[]                  @relation("fk_41_rule_tenant_id")
  templates              Template[]              @relation("fk_43_template_tenant_id")
  offerings              Offering[]              @relation("fk_46_offering_tenant_id")
  layoutTemplates        LayoutTemplate[]        @relation("fk_49_layout_template_tenant_id")
  resources              Resource[]              @relation("fk_54_resource_tenant_id")
  serviceLines           ServiceLine[]           @relation("fk_60_service_line_tenant_id")
  schedules              Schedule[]              @relation("fk_64_schedule_tenant_id")
  fareRules              FareRule[]              @relation("fk_67_fare_rule_tenant_id")
  ancillaryProducts      AncillaryProduct[]      @relation("fk_70_ancillary_product_tenant_id")
  ancillaryOffers        AncillaryOffer[]        @relation("fk_72_ancillary_offer_tenant_id")
  trips                  Trip[]                  @relation("fk_74_trip_tenant_id")
  tripUnits              TripUnit[]              @relation("fk_80_trip_unit_tenant_id")
  holds                  Hold[]                  @relation("fk_88_hold_tenant_id")
  allocationRules        AllocationRule[]        @relation("fk_96_allocation_rule_tenant_id")
  allocationEvents       AllocationEvent[]       @relation("fk_99_allocation_event_tenant_id")
  tripChanges            TripChange[]            @relation("fk_103_trip_change_tenant_id")
  bookings               Booking[]               @relation("fk_106_booking_tenant_id")
  travelers              Traveler[]              @relation("fk_111_traveler_tenant_id")
  travelerDocuments      TravelerDocument[]      @relation("fk_113_traveler_document_tenant_id")
  bookingItems           BookingItem[]           @relation("fk_115_booking_item_tenant_id")
  bookingPriceLines      BookingPriceLine[]      @relation("fk_121_booking_price_line_tenant_id")
  tickets                Ticket[]                @relation("fk_125_ticket_tenant_id")
  payments               Payment[]               @relation("fk_127_payment_tenant_id")
  refunds                Refund[]                @relation("fk_129_refund_tenant_id")
  promos                 Promo[]                 @relation("fk_133_promo_tenant_id")
  promoRedemptions       PromoRedemption[]       @relation("fk_134_promo_redemption_tenant_id")
  walletAccounts         WalletAccount[]         @relation("fk_138_wallet_account_tenant_id")
  loyaltyAccounts        LoyaltyAccount[]        @relation("fk_140_loyalty_account_tenant_id")
  ledgerEntries          LedgerEntry[]           @relation("fk_142_ledger_entry_tenant_id")
  settlements            Settlement[]            @relation("fk_143_settlement_tenant_id")
  notificationLogs       NotificationLog[]       @relation("fk_144_notification_log_tenant_id")
  supplierConnections    SupplierConnection[]    @relation("fk_146_supplier_connection_tenant_id")
  externalMappings       ExternalMapping[]       @relation("fk_148_external_mapping_tenant_id")
  integrationLogs        IntegrationLog[]        @relation("fk_152_integration_log_tenant_id")
  crewMembers            CrewMember[]            @relation("fk_154_crew_member_tenant_id")
  crewDocuments          CrewDocument[]          @relation("fk_158_crew_document_tenant_id")
  crewLeaves             CrewLeave[]             @relation("fk_160_crew_leave_tenant_id")
  crewRequirements       CrewRequirement[]       @relation("fk_162_crew_requirement_tenant_id")
  resourceCrews          ResourceCrew[]          @relation("fk_166_resource_crew_tenant_id")
  tripCrews              TripCrew[]              @relation("fk_169_trip_crew_tenant_id")

  @@index([planId])
  @@map("tenant")
}

model TenantProductType {
  tenantId      BigInt      @map("tenant_id")
  productTypeId BigInt      @map("product_type_id")
  isActive      Boolean     @map("is_active")
  tenant        Tenant      @relation("fk_2_tenant_product_type_tenant_id", fields: [tenantId], references: [id])
  productType   ProductType @relation("fk_3_tenant_product_type_product_type_id", fields: [productTypeId], references: [id])

  @@id([tenantId, productTypeId])
  @@index([productTypeId])
  @@map("tenant_product_type")
}

model Branch {
  id              BigInt           @id @default(autoincrement())
  tenantId        BigInt           @map("tenant_id")
  code            String           @db.VarChar(50)
  name            String           @db.VarChar(100)
  city            String?          @db.VarChar(100)
  address         String?          @db.Text
  phone           String?          @db.VarChar(30)
  tenant          Tenant           @relation("fk_4_branch_tenant_id", fields: [tenantId], references: [id])
  agents          Agent[]          @relation("fk_6_agent_branch_id")
  memberships     Membership[]     @relation("fk_11_membership_branch_id")
  tripUnits       TripUnit[]       @relation("fk_82_trip_unit_branch_id")
  holds           Hold[]           @relation("fk_92_hold_branch_id")
  allocationRules AllocationRule[] @relation("fk_97_allocation_rule_branch_id")
  bookings        Booking[]        @relation("fk_108_booking_branch_id")
  crewMembers     CrewMember[]     @relation("fk_156_crew_member_branch_id")

  @@index([tenantId])
  @@map("branch")
}

model Agent {
  id              BigInt           @id @default(autoincrement())
  tenantId        BigInt           @map("tenant_id")
  branchId        BigInt?          @map("branch_id")
  name            String           @db.VarChar(100)
  phone           String?          @db.VarChar(30)
  email           String?          @db.VarChar(100)
  creditLimit     BigInt           @map("credit_limit")
  currentBalance  BigInt           @map("current_balance")
  commissionRate  Decimal          @db.Decimal(5, 2) @map("commission_rate")
  status          String           @db.VarChar(30)
  tenant          Tenant           @relation("fk_5_agent_tenant_id", fields: [tenantId], references: [id])
  branch          Branch?          @relation("fk_6_agent_branch_id", fields: [branchId], references: [id])
  apiKeys         ApiKey[]         @relation("fk_29_api_key_agent_id")
  tripUnits       TripUnit[]       @relation("fk_83_trip_unit_agent_id")
  holds           Hold[]           @relation("fk_93_hold_agent_id")
  allocationRules AllocationRule[] @relation("fk_98_allocation_rule_agent_id")
  bookings        Booking[]        @relation("fk_109_booking_agent_id")

  @@index([tenantId])
  @@index([branchId])
  @@map("agent")
}

model Plan {
  id           BigInt        @id @default(autoincrement())
  code         String        @unique @db.VarChar(50)
  name         String        @db.VarChar(100)
  tenants      Tenant[]      @relation("fk_1_tenant_plan_id")
  planFeatures PlanFeature[] @relation("fk_7_plan_feature_plan_id")

  @@map("plan")
}

model PlanFeature {
  planId     BigInt  @map("plan_id")
  featureKey String  @db.VarChar(50) @map("feature_key")
  config     Json?
  isEnabled  Boolean @map("is_enabled")
  plan       Plan    @relation("fk_7_plan_feature_plan_id", fields: [planId], references: [id])

  @@id([planId, featureKey])
  @@map("plan_feature")
}

model TenantSetting {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  scopeType String   @db.VarChar(50) @map("scope_type")
  scopeId   BigInt   @map("scope_id")
  key       String   @db.VarChar(100)
  value     Json?
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  tenant    Tenant   @relation("fk_8_tenant_setting_tenant_id", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tenant_setting")
}

model StaffUser {
  id                        BigInt            @id @default(autoincrement())
  email                     String?           @db.VarChar(100)
  phone                     String?           @db.VarChar(30)
  fullName                  String            @db.VarChar(100) @map("full_name")
  mfaEnabled                Boolean           @map("mfa_enabled")
  status                    String            @db.VarChar(30)
  createdAt                 DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  memberships               Membership[]      @relation("fk_9_membership_staff_user_id")
  approvalRequestsByMaker   ApprovalRequest[] @relation("fk_17_approval_request_maker_id")
  approvalRequestsByChecker ApprovalRequest[] @relation("fk_18_approval_request_checker_id")
  holds                     Hold[]            @relation("fk_91_hold_staff_user_id")
  allocationEvents          AllocationEvent[] @relation("fk_102_allocation_event_actor_id")
  tripChanges               TripChange[]      @relation("fk_105_trip_change_actor_id")
  bookings                  Booking[]         @relation("fk_110_booking_sold_by")
  refunds                   Refund[]          @relation("fk_132_refund_approved_by")
  crewMember                CrewMember?       @relation("fk_155_crew_member_staff_user_id")
  tripCrews                 TripCrew[]        @relation("fk_172_trip_crew_assigned_by")

  @@map("staff_user")
}

model Membership {
  id          BigInt    @id @default(autoincrement())
  staffUserId BigInt    @map("staff_user_id")
  tenantId    BigInt?   @map("tenant_id")
  branchId    BigInt?   @map("branch_id")
  roleId      BigInt    @map("role_id")
  status      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  staffUser   StaffUser @relation("fk_9_membership_staff_user_id", fields: [staffUserId], references: [id])
  tenant      Tenant?   @relation("fk_10_membership_tenant_id", fields: [tenantId], references: [id])
  branch      Branch?   @relation("fk_11_membership_branch_id", fields: [branchId], references: [id])
  role        Role      @relation("fk_12_membership_role_id", fields: [roleId], references: [id])

  @@index([staffUserId])
  @@index([tenantId])
  @@index([branchId])
  @@index([roleId])
  @@map("membership")
}

model Role {
  id              BigInt           @id @default(autoincrement())
  tenantId        BigInt?          @map("tenant_id")
  name            String           @db.VarChar(50)
  isSystem        Boolean          @map("is_system")
  tenant          Tenant?          @relation("fk_13_role_tenant_id", fields: [tenantId], references: [id])
  memberships     Membership[]     @relation("fk_12_membership_role_id")
  rolePermissions RolePermission[] @relation("fk_14_role_permission_role_id")

  @@index([tenantId])
  @@map("role")
}

model Permission {
  id              BigInt           @id @default(autoincrement())
  code            String           @unique @db.VarChar(100)
  description     String?          @db.Text
  rolePermissions RolePermission[] @relation("fk_15_role_permission_permission_id")

  @@map("permission")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  role         Role       @relation("fk_14_role_permission_role_id", fields: [roleId], references: [id])
  permission   Permission @relation("fk_15_role_permission_permission_id", fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model ApprovalRequest {
  id         BigInt     @id @default(autoincrement())
  tenantId   BigInt     @map("tenant_id")
  makerId    BigInt     @map("maker_id")
  checkerId  BigInt?    @map("checker_id")
  actionType String     @db.VarChar(50) @map("action_type")
  payload    Json?
  status     String     @db.VarChar(30)
  reviewedAt DateTime?  @db.Timestamptz(6) @map("reviewed_at")
  tenant     Tenant     @relation("fk_16_approval_request_tenant_id", fields: [tenantId], references: [id])
  maker      StaffUser  @relation("fk_17_approval_request_maker_id", fields: [makerId], references: [id])
  checker    StaffUser? @relation("fk_18_approval_request_checker_id", fields: [checkerId], references: [id])

  @@index([tenantId])
  @@index([makerId])
  @@index([checkerId])
  @@map("approval_request")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  actorType  String   @db.VarChar(50) @map("actor_type")
  actorId    BigInt   @map("actor_id")
  action     String   @db.VarChar(50)
  entityType String   @db.VarChar(50) @map("entity_type")
  entityId   BigInt   @map("entity_id")
  diff       Json?
  ipAddress  String?  @db.VarChar(45) @map("ip_address")
  userAgent  String?  @db.Text @map("user_agent")
  createdAt  DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@map("audit_log")
}

// ================================================================
// Cluster B: Customers and Integration
// ================================================================

model CustomerIdentity {
  id               BigInt            @id @default(autoincrement())
  phone            String?           @unique @db.VarChar(30)
  email            String?           @unique @db.VarChar(100)
  fullName         String            @db.VarChar(100) @map("full_name")
  createdAt        DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  customerProfiles CustomerProfile[] @relation("fk_20_customer_profile_identity_id")
  customerSessions CustomerSession[] @relation("fk_25_customer_session_identity_id")

  @@map("customer_identity")
}

model CustomerProfile {
  id               BigInt            @id @default(autoincrement())
  tenantId         BigInt            @map("tenant_id")
  identityId       BigInt            @map("identity_id")
  displayName      String            @db.VarChar(100) @map("display_name")
  consentMarketing Boolean           @map("consent_marketing")
  consentDataShare Boolean           @map("consent_data_share")
  createdAt        DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6) @map("updated_at")
  tenant           Tenant            @relation("fk_19_customer_profile_tenant_id", fields: [tenantId], references: [id])
  identity         CustomerIdentity  @relation("fk_20_customer_profile_identity_id", fields: [identityId], references: [id])
  savedTravelers   SavedTraveler[]   @relation("fk_22_saved_traveler_profile_id")
  holds            Hold[]            @relation("fk_90_hold_profile_id")
  bookings         Booking[]         @relation("fk_107_booking_customer_profile_id")
  promoRedemptions PromoRedemption[] @relation("fk_137_promo_redemption_profile_id")
  walletAccounts   WalletAccount[]   @relation("fk_139_wallet_account_profile_id")
  loyaltyAccount   LoyaltyAccount?   @relation("fk_141_loyalty_account_profile_id")

  @@index([tenantId])
  @@index([identityId])
  @@unique([tenantId, identityId])
  @@map("customer_profile")
}

model SavedTraveler {
  id                     BigInt                  @id @default(autoincrement())
  tenantId               BigInt                  @map("tenant_id")
  profileId              BigInt                  @map("profile_id")
  name                   String                  @db.VarChar(100)
  gender                 String                  @db.VarChar(20)
  dateOfBirth            DateTime?               @db.Date @map("date_of_birth")
  nationality            String                  @db.VarChar(50)
  travelerType           String                  @db.VarChar(30) @map("traveler_type")
  tenant                 Tenant                  @relation("fk_21_saved_traveler_tenant_id", fields: [tenantId], references: [id])
  profile                CustomerProfile         @relation("fk_22_saved_traveler_profile_id", fields: [profileId], references: [id])
  savedTravelerDocuments SavedTravelerDocument[] @relation("fk_24_saved_traveler_document_saved_traveler_id")

  @@index([tenantId])
  @@index([profileId])
  @@map("saved_traveler")
}

model SavedTravelerDocument {
  id                      BigInt        @id @default(autoincrement())
  tenantId                BigInt        @map("tenant_id")
  savedTravelerId         BigInt        @map("saved_traveler_id")
  docTypeCode             String        @db.VarChar(50) @map("doc_type_code")
  documentNumberEncrypted String?       @db.Text @map("document_number_encrypted")
  expiryDate              DateTime?     @db.Date @map("expiry_date")
  countryCode             String        @db.VarChar(10) @map("country_code")
  tenant                  Tenant        @relation("fk_23_saved_traveler_document_tenant_id", fields: [tenantId], references: [id])
  savedTraveler           SavedTraveler @relation("fk_24_saved_traveler_document_saved_traveler_id", fields: [savedTravelerId], references: [id])

  @@index([tenantId])
  @@index([savedTravelerId])
  @@map("saved_traveler_document")
}

model CustomerSession {
  id         BigInt           @id @default(autoincrement())
  identityId BigInt           @map("identity_id")
  tenantId   BigInt           @map("tenant_id")
  tokenHash  String           @db.VarChar(255) @map("token_hash")
  expiresAt  DateTime?        @db.Timestamptz(6) @map("expires_at")
  identity   CustomerIdentity @relation("fk_25_customer_session_identity_id", fields: [identityId], references: [id])
  tenant     Tenant           @relation("fk_26_customer_session_tenant_id", fields: [tenantId], references: [id])

  @@index([identityId])
  @@index([tenantId])
  @@map("customer_session")
}

model SalesDomain {
  id         BigInt  @id @default(autoincrement())
  tenantId   BigInt  @map("tenant_id")
  domainName String  @db.VarChar(255) @map("domain_name")
  isPrimary  Boolean @map("is_primary")
  isVerified Boolean @map("is_verified")
  tenant     Tenant  @relation("fk_27_sales_domain_tenant_id", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("sales_domain")
}

model ApiKey {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  agentId        BigInt?  @map("agent_id")
  keyType        String   @db.VarChar(30) @map("key_type")
  publicKey      String   @db.VarChar(100) @map("public_key")
  secretHash     String   @db.VarChar(255) @map("secret_hash")
  allowedOrigins String[] @default([]) @db.Text @map("allowed_origins")
  scopes         String[] @default([]) @db.Text
  isActive       Boolean  @map("is_active")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  tenant         Tenant   @relation("fk_28_api_key_tenant_id", fields: [tenantId], references: [id])
  agent          Agent?   @relation("fk_29_api_key_agent_id", fields: [agentId], references: [id])

  @@index([tenantId])
  @@index([agentId])
  @@map("api_key")
}

model WebhookEndpoint {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  url        String?  @db.Text
  secret     String   @db.VarChar(255)
  eventTypes String[] @default([]) @db.Text @map("event_types")
  isActive   Boolean  @map("is_active")
  tenant     Tenant   @relation("fk_30_webhook_endpoint_tenant_id", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook_endpoint")
}

model OutboxEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  topic     String   @db.VarChar(100)
  eventType String   @db.VarChar(100) @map("event_type")
  payload   Json?
  status    String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  tenant    Tenant   @relation("fk_31_outbox_event_tenant_id", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("outbox_event")
}

model IdempotencyKey {
  tenantId       BigInt    @map("tenant_id")
  key            String    @db.VarChar(100)
  responseStatus Int       @map("response_status")
  responseBody   Json?     @map("response_body")
  expiresAt      DateTime? @db.Timestamptz(6) @map("expires_at")
  tenant         Tenant    @relation("fk_32_idempotency_key_tenant_id", fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("idempotency_key")
}

// ================================================================
// Cluster C: Registries and Rules
// ================================================================

model ProductType {
  id                   BigInt                @id @default(autoincrement())
  code                 String                @unique @db.VarChar(50)
  name                 String                @db.VarChar(100)
  inventoryModel       String                @db.VarChar(50) @map("inventory_model")
  defaultWorkflowId    BigInt?               @map("default_workflow_id")
  config               Json?
  isActive             Boolean               @map("is_active")
  defaultWorkflow      Workflow?             @relation("fk_33_product_type_default_workflow_id", fields: [defaultWorkflowId], references: [id])
  tenantProductTypes   TenantProductType[]   @relation("fk_3_tenant_product_type_product_type_id")
  lookupValues         LookupValue[]         @relation("fk_35_lookup_value_product_type_id")
  attributeDefinitions AttributeDefinition[] @relation("fk_36_attribute_definition_product_type_id")
  policyDefinitions    PolicyDefinition[]    @relation("fk_37_policy_definition_product_type_id")
  workflows            Workflow[]            @relation("fk_38_workflow_product_type_id")
  rules                Rule[]                @relation("fk_42_rule_product_type_id")
  templates            Template[]            @relation("fk_44_template_product_type_id")
  offerings            Offering[]            @relation("fk_47_offering_product_type_id")
  layoutTemplates      LayoutTemplate[]      @relation("fk_50_layout_template_product_type_id")
  resources            Resource[]            @relation("fk_55_resource_product_type_id")
  serviceLines         ServiceLine[]         @relation("fk_61_service_line_product_type_id")
  ancillaryProducts    AncillaryProduct[]    @relation("fk_71_ancillary_product_product_type_id")
  trips                Trip[]                @relation("fk_75_trip_product_type_id")
  supplierConnections  SupplierConnection[]  @relation("fk_147_supplier_connection_product_type_id")
  crewRequirements     CrewRequirement[]     @relation("fk_163_crew_requirement_product_type_id")

  @@index([defaultWorkflowId])
  @@map("product_type")
}

model LookupType {
  id           BigInt        @id @default(autoincrement())
  code         String        @db.VarChar(50)
  name         String        @db.VarChar(100)
  lookupValues LookupValue[] @relation("fk_34_lookup_value_lookup_type_id")

  @@map("lookup_type")
