// A workflow's states are lookup_dtl rows (label comes from lookup_dtl.label)
model WorkflowStatus {
  workflowId BigInt    @map("workflow_id")
  statusId   BigInt    @map("status_id") // lookup_dtl (any *_STATUS group)
  isTerminal Boolean   @map("is_terminal")
  workflow   Workflow  @relation("fk_39_workflow_status_workflow_id", fields: [workflowId], references: [id])
  status     LookupDtl @relation("lk_WorkflowStatus_status", fields: [statusId], references: [id])

  @@id([workflowId, statusId])
  @@index([statusId])
  @@map("workflow_status")
