  holdsByStatus                  Hold[]                      @relation("lk_Hold_status")
  holdsByChannel                 Hold[]                      @relation("lk_Hold_channel")
  allocationRulesByScopeType     AllocationRule[]            @relation("lk_AllocationRule_scopeType")
  allocationRulesByPool          AllocationRule[]            @relation("lk_AllocationRule_pool")
