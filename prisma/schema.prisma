  @@map("integration_log")
}

// ================================================================
// Cluster H: Crew Management
// ================================================================

model CrewMember {
  id               BigInt           @id @default(autoincrement())
  tenantId         BigInt           @map("tenant_id")
  staffUserId      BigInt?          @unique @map("staff_user_id")
  branchId         BigInt?          @map("branch_id")
  firstName        String           @db.VarChar(50) @map("first_name")
  lastName         String           @db.VarChar(50) @map("last_name")
  phone            String?          @db.VarChar(30)
  emergencyContact String           @db.VarChar(50) @map("emergency_contact")
  employmentType   String           @db.VarChar(30) @map("employment_type")
  status           String           @db.VarChar(30)
  hireDate         DateTime?        @db.Date @map("hire_date")
  address          String?          @db.Text
  attributes       Json?
  tenant           Tenant           @relation("fk_154_crew_member_tenant_id", fields: [tenantId], references: [id])
  staffUser        StaffUser?       @relation("fk_155_crew_member_staff_user_id", fields: [staffUserId], references: [id])
  branch           Branch?          @relation("fk_156_crew_member_branch_id", fields: [branchId], references: [id])
  crewMemberRoles  CrewMemberRole[] @relation("fk_157_crew_member_role_crew_member_id")
  crewDocuments    CrewDocument[]   @relation("fk_159_crew_document_crew_member_id")
  crewLeaves       CrewLeave[]      @relation("fk_161_crew_leave_crew_member_id")
  resourceCrews    ResourceCrew[]   @relation("fk_168_resource_crew_crew_member_id")
  tripCrews        TripCrew[]       @relation("fk_171_trip_crew_crew_member_id")

  @@index([tenantId])
  @@index([branchId])
  @@map("crew_member")
}

model CrewMemberRole {
  crewMemberId BigInt     @map("crew_member_id")
  crewRoleCode String     @db.VarChar(50) @map("crew_role_code")
  isPrimary    Boolean    @map("is_primary")
  notes        String?    @db.Text
  crewMember   CrewMember @relation("fk_157_crew_member_role_crew_member_id", fields: [crewMemberId], references: [id])

  @@id([crewMemberId, crewRoleCode])
  @@map("crew_member_role")
}

model CrewDocument {
  id                   BigInt     @id @default(autoincrement())
  tenantId             BigInt     @map("tenant_id")
  crewMemberId         BigInt     @map("crew_member_id")
  docType              String     @db.VarChar(50) @map("doc_type")
  numberEncrypted      String?    @db.Text @map("number_encrypted")
  issueDate            DateTime?  @db.Date @map("issue_date")
  expiryDate           DateTime?  @db.Date @map("expiry_date")
  issuingAuthority     String     @db.VarChar(100) @map("issuing_authority")
  isVerified           Boolean    @map("is_verified")
  verificationMetadata Json?      @map("verification_metadata")
  tenant               Tenant     @relation("fk_158_crew_document_tenant_id", fields: [tenantId], references: [id])
  crewMember           CrewMember @relation("fk_159_crew_document_crew_member_id", fields: [crewMemberId], references: [id])

  @@index([tenantId])
  @@index([crewMemberId])
  @@map("crew_document")
}

model CrewLeave {
  id           BigInt     @id @default(autoincrement())
  tenantId     BigInt     @map("tenant_id")
  crewMemberId BigInt     @map("crew_member_id")
  leaveType    String     @db.VarChar(50) @map("leave_type")
  startDate    DateTime?  @db.Date @map("start_date")
  endDate      DateTime?  @db.Date @map("end_date")
  status       String     @db.VarChar(30)
  tenant       Tenant     @relation("fk_160_crew_leave_tenant_id", fields: [tenantId], references: [id])
  crewMember   CrewMember @relation("fk_161_crew_leave_crew_member_id", fields: [crewMemberId], references: [id])

  @@index([tenantId])
  @@index([crewMemberId])
  @@map("crew_leave")
}

model CrewRequirement {
  id            BigInt       @id @default(autoincrement())
  tenantId      BigInt       @map("tenant_id")
  productTypeId BigInt       @map("product_type_id")
  offeringId    BigInt?      @map("offering_id")
  serviceLineId BigInt?      @map("service_line_id")
  crewRoleCode  String       @db.VarChar(50) @map("crew_role_code")
  minCount      Int          @map("min_count")
  maxCount      Int          @map("max_count")
  tenant        Tenant       @relation("fk_162_crew_requirement_tenant_id", fields: [tenantId], references: [id])
  productType   ProductType  @relation("fk_163_crew_requirement_product_type_id", fields: [productTypeId], references: [id])
  offering      Offering?    @relation("fk_164_crew_requirement_offering_id", fields: [offeringId], references: [id])
  serviceLine   ServiceLine? @relation("fk_165_crew_requirement_service_line_id", fields: [serviceLineId], references: [id])

  @@index([tenantId])
  @@index([productTypeId])
  @@index([offeringId])
  @@index([serviceLineId])
  @@map("crew_requirement")
}

model ResourceCrew {
  id           BigInt     @id @default(autoincrement())
  tenantId     BigInt     @map("tenant_id")
  resourceId   BigInt     @map("resource_id")
  crewMemberId BigInt     @map("crew_member_id")
  crewRoleCode String     @db.VarChar(50) @map("crew_role_code")
  validFrom    DateTime?  @db.Date @map("valid_from")
  validTo      DateTime?  @db.Date @map("valid_to")
  tenant       Tenant     @relation("fk_166_resource_crew_tenant_id", fields: [tenantId], references: [id])
  resource     Resource   @relation("fk_167_resource_crew_resource_id", fields: [resourceId], references: [id])
  crewMember   CrewMember @relation("fk_168_resource_crew_crew_member_id", fields: [crewMemberId], references: [id])

  @@index([tenantId])
  @@index([resourceId])
  @@index([crewMemberId])
  @@map("resource_crew")
}

model TripCrew {
  id                    BigInt     @id @default(autoincrement())
  tenantId              BigInt     @map("tenant_id")
  tripId                BigInt     @map("trip_id")
  crewMemberId          BigInt     @map("crew_member_id")
  assignedBy            BigInt?    @map("assigned_by")
  replacedById          BigInt?    @map("replaced_by_id")
  crewRoleCode          String     @db.VarChar(50) @map("crew_role_code")
  dutyStatus            String     @db.VarChar(30) @map("duty_status")
  assignedAt            DateTime?  @db.Timestamptz(6) @map("assigned_at")
  checkedInAt           DateTime?  @db.Timestamptz(6) @map("checked_in_at")
  confirmedAt           DateTime?  @db.Timestamptz(6) @map("confirmed_at")
  notes                 String?    @db.Text
  tenant                Tenant     @relation("fk_169_trip_crew_tenant_id", fields: [tenantId], references: [id])
  trip                  Trip       @relation("fk_170_trip_crew_trip_id", fields: [tripId], references: [id])
  crewMember            CrewMember @relation("fk_171_trip_crew_crew_member_id", fields: [crewMemberId], references: [id])
  assignedByStaffUser   StaffUser? @relation("fk_172_trip_crew_assigned_by", fields: [assignedBy], references: [id])
  replacedBy            TripCrew?  @relation("fk_173_trip_crew_replaced_by_id", fields: [replacedById], references: [id])
  tripCrewsByReplacedBy TripCrew[] @relation("fk_173_trip_crew_replaced_by_id")

  @@index([tenantId])
  @@index([tripId])
  @@index([crewMemberId])
  @@index([assignedBy])
  @@index([replacedById])
  @@map("trip_crew")
}
