  tenantId     BigInt    @map("tenant_id")
  accountId    BigInt    @map("account_id")  // LEDGER_ACCOUNT
  debitAmount  BigInt    @map("debit_amount")
  creditAmount BigInt    @map("credit_amount")
  currencyId   BigInt    @map("currency_id")
  refTypeId    BigInt    @map("ref_type_id") // LEDGER_REF_TYPE
  refId        BigInt    @map("ref_id")
  postedAt     DateTime  @default(now()) @db.Timestamptz(6) @map("posted_at")
  account      LookupDtl @relation("lk_LedgerEntry_account", fields: [accountId], references: [id])
  refType      LookupDtl @relation("lk_LedgerEntry_refType", fields: [refTypeId], references: [id])
  currency     Currency  @relation("cur_LedgerEntry_currency", fields: [currencyId], references: [id])
  tenant       Tenant    @relation("fk_142_ledger_entry_tenant_id", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([accountId])
  @@index([currencyId])
  @@index([refTypeId, refId])
  @@map("ledger_entry")
}

model Settlement {
  id               BigInt    @id @default(autoincrement())
  tenantId         BigInt    @map("tenant_id")
  cycleStart       DateTime? @db.Date @map("cycle_start")
  cycleEnd         DateTime? @db.Date @map("cycle_end")
  grossSales       BigInt    @map("gross_sales")
  commissionFee    BigInt    @map("commission_fee")
  refundDeductions BigInt    @map("refund_deductions")
  payoutAmount     BigInt    @map("payout_amount")
  statusId         BigInt    @map("status_id") // SETTLEMENT_STATUS
  status           LookupDtl @relation("lk_Settlement_status", fields: [statusId], references: [id])
  tenant           Tenant    @relation("fk_143_settlement_tenant_id", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([statusId])
  @@map("settlement")
}

model NotificationLog {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt    @map("tenant_id")
  templateId BigInt    @map("template_id")
  channelId  BigInt    @map("channel_id") // NOTIFICATION_CHANNEL
  recipient  String    @db.VarChar(100)
  subject    String    @db.VarChar(255)
  statusId   BigInt    @map("status_id")  // NOTIFICATION_STATUS
  sentAt     DateTime? @db.Timestamptz(6) @map("sent_at")
  metadata   Json?
  channel    LookupDtl @relation("lk_NotificationLog_channel", fields: [channelId], references: [id])
  status     LookupDtl @relation("lk_NotificationLog_status", fields: [statusId], references: [id])
  tenant     Tenant    @relation("fk_144_notification_log_tenant_id", fields: [tenantId], references: [id])
  template   Template  @relation("fk_145_notification_log_template_id", fields: [templateId], references: [id])

  @@index([tenantId])
  @@index([templateId])
  @@index([channelId])
  @@index([statusId])
  @@map("notification_log")
}

// ================================================================
// Cluster G: Supplier Integration
// ================================================================

model SupplierConnection {
  id                  BigInt               @id @default(autoincrement())
  tenantId            BigInt               @map("tenant_id")
  productTypeId       BigInt               @map("product_type_id")
  supplierName        String               @db.VarChar(100) @map("supplier_name")
  supplyModeId        BigInt               @map("supply_mode_id") // SUPPLY_MODE
  apiEndpoint         String?              @db.Text @map("api_endpoint")
  authTypeId          BigInt               @map("auth_type_id")   // SUPPLIER_AUTH_TYPE
  statusId            BigInt               @map("status_id")      // CONNECTION_STATUS
  config              Json?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  version             Int                  @default(1)
  supplyMode          LookupDtl            @relation("lk_SupplierConnection_supplyMode", fields: [supplyModeId], references: [id])
  authType            LookupDtl            @relation("lk_SupplierConnection_authType", fields: [authTypeId], references: [id])
  status              LookupDtl            @relation("lk_SupplierConnection_status", fields: [statusId], references: [id])
  tenant              Tenant               @relation("fk_146_supplier_connection_tenant_id", fields: [tenantId], references: [id])
  productType         ProductType          @relation("fk_147_supplier_connection_product_type_id", fields: [productTypeId], references: [id])
  externalMappings    ExternalMapping[]    @relation("fk_149_external_mapping_connection_id")
  supplierBookingRefs SupplierBookingRef[] @relation("fk_151_supplier_booking_ref_connection_id")
  integrationLogs     IntegrationLog[]     @relation("fk_153_integration_log_connection_id")

  @@index([tenantId])
  @@index([productTypeId])
  @@index([statusId])
  @@map("supplier_connection")
}

model ExternalMapping {
  id           BigInt             @id @default(autoincrement())
  tenantId     BigInt             @map("tenant_id")
  connectionId BigInt             @map("connection_id")
  entityTypeId BigInt             @map("entity_type_id") // ENTITY_TYPE
  internalId   BigInt             @map("internal_id")
  externalCode String             @db.VarChar(100) @map("external_code")
  metadata     Json?
  entityType   LookupDtl          @relation("lk_ExternalMapping_entityType", fields: [entityTypeId], references: [id])
  tenant       Tenant             @relation("fk_148_external_mapping_tenant_id", fields: [tenantId], references: [id])
  connection   SupplierConnection @relation("fk_149_external_mapping_connection_id", fields: [connectionId], references: [id])

  @@index([tenantId])
  @@index([connectionId])
  @@index([entityTypeId])
  @@map("external_mapping")
}

model SupplierBookingRef {
  tenantId      BigInt             @map("tenant_id")
  bookingItemId BigInt             @map("booking_item_id")
  connectionId  BigInt             @map("connection_id")
  supplierPnr   String             @db.VarChar(100) @map("supplier_pnr")
  bookingItem   BookingItem        @relation("fk_150_supplier_booking_ref_booking_item_id", fields: [bookingItemId], references: [id])
  connection    SupplierConnection @relation("fk_151_supplier_booking_ref_connection_id", fields: [connectionId], references: [id])

  @@id([bookingItemId, connectionId])
  @@index([connectionId])
  @@map("supplier_booking_ref")
}

model IntegrationLog {
  id              BigInt             @id @default(autoincrement())
  tenantId        BigInt             @map("tenant_id")
  connectionId    BigInt             @map("connection_id")
  directionId     BigInt             @map("direction_id") // INTEGRATION_DIRECTION
  endpoint        String?            @db.Text
  statusCode      Int                @map("status_code")  // HTTP status code (numeric, not a lookup)
  latencyMs       Int                @map("latency_ms")
  requestPayload  Json?              @map("request_payload")
  responsePayload Json?              @map("response_payload")
  direction       LookupDtl          @relation("lk_IntegrationLog_direction", fields: [directionId], references: [id])
  tenant          Tenant             @relation("fk_152_integration_log_tenant_id", fields: [tenantId], references: [id])
  connection      SupplierConnection @relation("fk_153_integration_log_connection_id", fields: [connectionId], references: [id])

  @@index([tenantId])
  @@index([connectionId])
  @@index([directionId])
  @@map("integration_log")
}

// ================================================================
// Cluster H: Crew Management
// ================================================================

model CrewMember {
  id               BigInt           @id @default(autoincrement())
  tenantId         BigInt           @map("tenant_id")
  staffUserId      BigInt?          @unique @map("staff_user_id")
  branchId         BigInt?          @map("branch_id")
  firstName        String           @db.VarChar(50) @map("first_name")
  lastName         String           @db.VarChar(50) @map("last_name")
  phone            String?          @db.VarChar(30)
  emergencyContact String           @db.VarChar(50) @map("emergency_contact")
  employmentTypeId BigInt           @map("employment_type_id") // EMPLOYMENT_TYPE
  statusId         BigInt           @map("status_id")          // CREW_STATUS
  hireDate         DateTime?        @db.Date @map("hire_date")
  address          String?          @db.Text
  attributes       Json?
  employmentType   LookupDtl        @relation("lk_CrewMember_employmentType", fields: [employmentTypeId], references: [id])
  status           LookupDtl        @relation("lk_CrewMember_status", fields: [statusId], references: [id])
  tenant           Tenant           @relation("fk_154_crew_member_tenant_id", fields: [tenantId], references: [id])
  staffUser        StaffUser?       @relation("fk_155_crew_member_staff_user_id", fields: [staffUserId], references: [id])
  branch           Branch?          @relation("fk_156_crew_member_branch_id", fields: [branchId], references: [id])
  crewMemberRoles  CrewMemberRole[] @relation("fk_157_crew_member_role_crew_member_id")
  crewDocuments    CrewDocument[]   @relation("fk_159_crew_document_crew_member_id")
  crewLeaves       CrewLeave[]      @relation("fk_161_crew_leave_crew_member_id")
  resourceCrews    ResourceCrew[]   @relation("fk_168_resource_crew_crew_member_id")
  tripCrews        TripCrew[]       @relation("fk_171_trip_crew_crew_member_id")

  @@index([tenantId])
  @@index([branchId])
  @@index([statusId])
  @@map("crew_member")
}

model CrewMemberRole {
  crewMemberId BigInt     @map("crew_member_id")
  crewRoleId   BigInt     @map("crew_role_id") // CREW_ROLE
  isPrimary    Boolean    @map("is_primary")
  notes        String?    @db.Text
  crewRole     LookupDtl  @relation("lk_CrewMemberRole_crewRole", fields: [crewRoleId], references: [id])
  crewMember   CrewMember @relation("fk_157_crew_member_role_crew_member_id", fields: [crewMemberId], references: [id])

  @@id([crewMemberId, crewRoleId])
  @@index([crewRoleId])
  @@map("crew_member_role")
}

model CrewDocument {
  id                   BigInt     @id @default(autoincrement())
  tenantId             BigInt     @map("tenant_id")
  crewMemberId         BigInt     @map("crew_member_id")
  docTypeId            BigInt     @map("doc_type_id") // CREW_DOC_TYPE
  numberEncrypted      String?    @db.Text @map("number_encrypted")
  issueDate            DateTime?  @db.Date @map("issue_date")
  expiryDate           DateTime?  @db.Date @map("expiry_date")
  issuingAuthority     String     @db.VarChar(100) @map("issuing_authority")
  isVerified           Boolean    @map("is_verified")
  verificationMetadata Json?      @map("verification_metadata")
  docType              LookupDtl  @relation("lk_CrewDocument_docType", fields: [docTypeId], references: [id])
  tenant               Tenant     @relation("fk_158_crew_document_tenant_id", fields: [tenantId], references: [id])
  crewMember           CrewMember @relation("fk_159_crew_document_crew_member_id", fields: [crewMemberId], references: [id])

  @@index([tenantId])
  @@index([crewMemberId])
  @@index([docTypeId])
  @@map("crew_document")
}

model CrewLeave {
  id           BigInt     @id @default(autoincrement())
  tenantId     BigInt     @map("tenant_id")
  crewMemberId BigInt     @map("crew_member_id")
  leaveTypeId  BigInt     @map("leave_type_id") // LEAVE_TYPE
  startDate    DateTime?  @db.Date @map("start_date")
  endDate      DateTime?  @db.Date @map("end_date")
  statusId     BigInt     @map("status_id")     // LEAVE_STATUS
  leaveType    LookupDtl  @relation("lk_CrewLeave_leaveType", fields: [leaveTypeId], references: [id])
  status       LookupDtl  @relation("lk_CrewLeave_status", fields: [statusId], references: [id])
  tenant       Tenant     @relation("fk_160_crew_leave_tenant_id", fields: [tenantId], references: [id])
  crewMember   CrewMember @relation("fk_161_crew_leave_crew_member_id", fields: [crewMemberId], references: [id])

  @@index([tenantId])
  @@index([crewMemberId])
  @@index([statusId])
  @@map("crew_leave")
}

model CrewRequirement {
  id            BigInt       @id @default(autoincrement())
  tenantId      BigInt       @map("tenant_id")
  productTypeId BigInt       @map("product_type_id")
  offeringId    BigInt?      @map("offering_id")
  serviceLineId BigInt?      @map("service_line_id")
  crewRoleId    BigInt       @map("crew_role_id") // CREW_ROLE
  minCount      Int          @map("min_count")
  maxCount      Int          @map("max_count")
  crewRole      LookupDtl    @relation("lk_CrewRequirement_crewRole", fields: [crewRoleId], references: [id])
  tenant        Tenant       @relation("fk_162_crew_requirement_tenant_id", fields: [tenantId], references: [id])
  productType   ProductType  @relation("fk_163_crew_requirement_product_type_id", fields: [productTypeId], references: [id])
  offering      Offering?    @relation("fk_164_crew_requirement_offering_id", fields: [offeringId], references: [id])
  serviceLine   ServiceLine? @relation("fk_165_crew_requirement_service_line_id", fields: [serviceLineId], references: [id])

  @@index([tenantId])
  @@index([productTypeId])
  @@index([offeringId])
  @@index([serviceLineId])
  @@index([crewRoleId])
  @@map("crew_requirement")
}

model ResourceCrew {
  id           BigInt     @id @default(autoincrement())
  tenantId     BigInt     @map("tenant_id")
  resourceId   BigInt     @map("resource_id")
  crewMemberId BigInt     @map("crew_member_id")
  crewRoleId   BigInt     @map("crew_role_id") // CREW_ROLE
  validFrom    DateTime?  @db.Date @map("valid_from")
  validTo      DateTime?  @db.Date @map("valid_to")
  crewRole     LookupDtl  @relation("lk_ResourceCrew_crewRole", fields: [crewRoleId], references: [id])
  tenant       Tenant     @relation("fk_166_resource_crew_tenant_id", fields: [tenantId], references: [id])
  resource     Resource   @relation("fk_167_resource_crew_resource_id", fields: [resourceId], references: [id])
  crewMember   CrewMember @relation("fk_168_resource_crew_crew_member_id", fields: [crewMemberId], references: [id])

  @@index([tenantId])
  @@index([resourceId])
  @@index([crewMemberId])
  @@index([crewRoleId])
  @@map("resource_crew")
}

model TripCrew {
  id                    BigInt     @id @default(autoincrement())
  tenantId              BigInt     @map("tenant_id")
  tripId                BigInt     @map("trip_id")
  crewMemberId          BigInt     @map("crew_member_id")
  assignedBy            BigInt?    @map("assigned_by")
  replacedById          BigInt?    @map("replaced_by_id")
  crewRoleId            BigInt     @map("crew_role_id")   // CREW_ROLE
  dutyStatusId          BigInt     @map("duty_status_id") // DUTY_STATUS
  assignedAt            DateTime?  @db.Timestamptz(6) @map("assigned_at")
  checkedInAt           DateTime?  @db.Timestamptz(6) @map("checked_in_at")
  confirmedAt           DateTime?  @db.Timestamptz(6) @map("confirmed_at")
  notes                 String?    @db.Text
  crewRole              LookupDtl  @relation("lk_TripCrew_crewRole", fields: [crewRoleId], references: [id])
  dutyStatus            LookupDtl  @relation("lk_TripCrew_dutyStatus", fields: [dutyStatusId], references: [id])
  tenant                Tenant     @relation("fk_169_trip_crew_tenant_id", fields: [tenantId], references: [id])
  trip                  Trip       @relation("fk_170_trip_crew_trip_id", fields: [tripId], references: [id])
  crewMember            CrewMember @relation("fk_171_trip_crew_crew_member_id", fields: [crewMemberId], references: [id])
  assignedByStaffUser   StaffUser? @relation("fk_172_trip_crew_assigned_by", fields: [assignedBy], references: [id])
  replacedBy            TripCrew?  @relation("fk_173_trip_crew_replaced_by_id", fields: [replacedById], references: [id])
  tripCrewsByReplacedBy TripCrew[] @relation("fk_173_trip_crew_replaced_by_id")

  @@index([tenantId])
  @@index([tripId])
  @@index([crewMemberId])
  @@index([assignedBy])
  @@index([replacedById])
  @@index([crewRoleId])
  @@index([dutyStatusId])
  @@map("trip_crew")
}